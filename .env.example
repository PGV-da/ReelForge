# ─────────────────────────────────────────────
# ReelForge Environment Configuration
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram user IDs allowed to use the bot
ADMIN_USER_IDS=123456789,987654321

# ── Instagram / Meta Graph API (Optional) ────
# Leave blank or commented out to run in local repurposing mode (no Instagram required)
# IG_USER_ID=your_instagram_business_account_id
# IG_ACCESS_TOKEN=your_long_lived_access_token
GRAPH_API_VERSION=v26.0

# ── Branding ──────────────────────────────────
WATERMARK_TEXT=@your_handle

# ── Whisper (Speech-to-Text) ──────────────────
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# ── LLM Caption Generator ────────────────────
# Provider options: groq, gemini, ollama
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
# Model name depends on provider:
#   groq:   llama-3.3-70b-versatile, mixtral-8x7b-32768
#   gemini: gemini-2.0-flash, gemini-2.5-pro
#   ollama: llama3.1, mistral (requires local Ollama server)
LLM_MODEL_NAME=llama-3.3-70b-versatile
# Only needed for Ollama
LLM_BASE_URL=http://localhost:11434

# ── Paths ─────────────────────────────────────
# Base directory for temporary job files
TEMP_BASE_DIR=/tmp/reelforge
# Optional: path to cookies.txt for yt-dlp (for rate-limited accounts)
# COOKIES_FILE=./cookies.txt

# ── Optional: Font Path Override ──────────────
# FONT_PATH=./assets/fonts/Montserrat-Bold.ttf
